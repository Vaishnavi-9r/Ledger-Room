# Copy this file to backend/.env.mattermost-development and replace every
# placeholder locally. Use a fresh, alphanumeric (hex is convenient) password.
# This file is for local development only; never point it at production.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ledgerroom_dev:REPLACE_WITH_LOCAL_HEX_PASSWORD@127.0.0.1:55432/ledgerroom_mattermost_dev

AUTH_JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_LOCAL_SECRET
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:5173

MATTERMOST_BASE_URL=http://127.0.0.1:45168
MATTERMOST_TEAM_ID=REPLACE_WITH_TEAM_ID_FROM_AUTHENTICATED_MATTERMOST
MATTERMOST_BOT_TOKEN=REPLACE_WITH_LEDGERROOM_SERVICE_ACCOUNT_TOKEN
MATTERMOST_SWITCH_BOT_USER_ID=REPLACE_WITH_SWITCH_BOT_USER_ID
MATTERMOST_OAUTH_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
MATTERMOST_OAUTH_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
MATTERMOST_OAUTH_CALLBACK_URL=http://127.0.0.1:8010/api/v1/integrations/mattermost/callback
MATTERMOST_RELAY_ENABLED=false
